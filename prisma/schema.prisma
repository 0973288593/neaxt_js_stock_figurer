generator client {
  provider = "prisma-client-js"
}


datasource db {
  provider = "mysql"
}

model Product {
  id          String         @id @default(uuid())
  name        String
  sku         String         @unique
  image       String
  price       Float
  price_cost  Float
  description String?
  created_at  DateTime       @default(now())
  images      ProductImage[]
  stock Int @default(0)
  payment_plans PaymentPlan[]
}

model ProductImage {
  id         String  @id @default(uuid())
  img_name   String
  product_id String

  product Product @relation(fields: [product_id], references: [id])
}

model Person {
  PersonID   Int      @id @default(autoincrement())
  LastName   String
  FirstName  String
  Address    String
  City       String
  Email      String   @unique
  Password   String
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@map("person")
}


model Customer {
  id   Int    @id @default(autoincrement())
  name String

  payment_plans PaymentPlan[]
}

model PaymentPlan {
  id Int @id @default(autoincrement())

  customer_id Int
  product_id  String

  total_amount     Decimal @db.Decimal(12, 2)
  deposit_amount   Decimal @db.Decimal(12, 2)
  remaining_amount Decimal @db.Decimal(12, 2)

  installment_count  Int
  installment_amount Decimal @db.Decimal(12, 2)

  start_date DateTime
  status     PaymentPlanStatus @default(ACTIVE)

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  customer Customer @relation(fields: [customer_id], references: [id])
  product  Product  @relation(fields: [product_id], references: [id])

  payments Payment[]

  @@index([customer_id])
  @@index([product_id])
  @@index([status])
}

model Payment {
  id Int @id @default(autoincrement())

  payment_plan_id Int

  amount       Decimal  @db.Decimal(12, 2)
  payment_date DateTime @default(now())

  payment_method PaymentMethod
  note           String?

  created_at DateTime @default(now())

  payment_plan PaymentPlan @relation(fields: [payment_plan_id], references: [id])

  @@index([payment_plan_id])
}

enum PaymentPlanStatus {
  ACTIVE
  COMPLETED
  CANCELLED
  OVERDUE
}

enum PaymentMethod {
  CASH
  TRANSFER
  QR
  CARD
  OTHER
}